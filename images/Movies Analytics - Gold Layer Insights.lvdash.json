{
  "datasets": [
    {
      "name": "gold_ratings_by_year",
      "displayName": "Ratings by Year",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.default.gold_movies_avg_rating_by_year\n",
        "ORDER BY\n",
        "  year_released"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "gold_movies_fact",
      "displayName": "Gold Movies Fact",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.default.gold_movies_fact"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "gold_by_language",
      "displayName": "Movies by Language",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.default.gold_movies_count_by_language\n",
        "ORDER BY\n",
        "  movie_count DESC"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "most_voted",
      "displayName": "Most Voted Movies",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.default.gold_movies_fact\n",
        "ORDER BY\n",
        "  vote_count DESC\n",
        "LIMIT 10"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "top_rated",
      "displayName": "Top Rated Movies",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.default.gold_movies_fact\n",
        "WHERE\n",
        "  vote_count >= 1000\n",
        "ORDER BY\n",
        "  vote_average DESC\n",
        "LIMIT 5"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "top_by_language",
      "displayName": "Top Movies per Language",
      "queryLines": [
        "WITH ranked_movies AS (\n",
        "  SELECT\n",
        "    original_language,\n",
        "    title,\n",
        "    vote_average,\n",
        "    ROW_NUMBER() OVER (PARTITION BY original_language ORDER BY vote_average DESC) as rn\n",
        "  FROM\n",
        "    workspace.default.gold_movies_fact\n",
        ")\n",
        "SELECT\n",
        "  original_language,\n",
        "  COUNT(*) as top_movies_count\n",
        "FROM\n",
        "  ranked_movies\n",
        "WHERE\n",
        "  rn <= 3\n",
        "GROUP BY\n",
        "  original_language"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "quality_rate",
      "displayName": "Quality Rate Value",
      "queryLines": [
        "SELECT\n",
        "  ROUND(1987.0 / 14000.0 * 100, 1) as quality_pct"
      ],
      "catalog": "workspace",
      "schema": "default"
    }
  ],
